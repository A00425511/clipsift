# Never commit: team code, secrets, local tooling
.team_key
**/.team_key
.dev.vars
.env
.wrangler/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.venv/

# Video and generated run output stay out of git (size, and rights on footage)
videos/
runs/*
!runs/.gitkeep
deploy/public/
*.mp4
*.MP4
*.mov
*.MOV
*.crdownload

# Marked-up partner screenshots and frames derived from them
labels/debug/

# Model weights and label frames stay out of git
models/
*.pth
*.onnx
label_sets/

# Blind labelling: local save file and pulled team labels hold names and marks
app/local_labels.jsonl
labels/team/

# Packaged app builds
build/
dist/

# Backup demo recordings are shipped on purpose
!docs/demo/*.mp4
